# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 git에서 제외되어 있다.
# 사용할 LLM: groq 또는 openai
LLM_PROVIDER=groq
# Groq 키: https://console.groq.com/keys
GROQ_API_KEY=
# 모델 목록: https://console.groq.com/docs/models
GROQ_MODEL=
# LLM_PROVIDER=openai일 때만 사용
OPENAI_API_KEY=
# 모델 목록: https://developers.openai.com/api/docs/models
OPENAI_MODEL=
