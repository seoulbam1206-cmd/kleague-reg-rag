# 비공개 문서: 절대 커밋 금지
docs_private/

# 비밀키
.env
.env.*

# 가상환경
.venv/
venv/
env/

# Python 부산물
__pycache__/
*.py[cod]
.pytest_cache/

# Claude Code 개인 설정
.claude/settings.local.json

# 다운로드 중간 파일
*.part

# 규정 PDF: 저장소에 올리지 않음 (scripts/download_regulations.py로 받음)
docs_public/*.pdf

# PDF에서 추출한 산출물: PDF와 같은 이유로 저장소에 올리지 않음
data/

# Streamlit 비밀값 (배포에서는 Cloud의 Secrets 설정에 넣는다)
.streamlit/secrets.toml

# 표 구조 검토 페이지 (scripts/build_table_review.py로 만든다. 원본 페이지 이미지가 들어 있음)
review/
